rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Filet de sécurité global (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Fonctions d'authentification et validation d'identité
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation du document profil utilisateur
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // Validation d'un portefeuille synchronisé
    function isValidPortfolio(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string && data.id.size() <= 128 &&
        data.key is string && data.key.size() <= 128 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
        (!('shortName' in data) || (data.shortName is string && data.shortName.size() <= 30)) &&
        (!('ticker' in data) || (data.ticker is string && data.ticker.size() <= 100)) &&
        (!('externalIsin' in data) || (data.externalIsin is string && data.externalIsin.size() <= 30)) &&
        (!('externalMic' in data) || (data.externalMic is string && data.externalMic.size() <= 20)) &&
        (!('yahooTicker' in data) || (data.yahooTicker is string && data.yahooTicker.size() <= 30)) &&
        (!('rows' in data) || (data.rows is list && data.rows.size() <= 5000)) &&
        (!('projectionType' in data) || (data.projectionType in ['buy', 'sell'])) &&
        (!('projectionVolume' in data) || data.projectionVolume is number) &&
        (!('projectionPrice' in data) || data.projectionPrice is number);
    }

    // Validation des réglages et préférences
    function isValidSettings(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        (!('selectedKey' in data) || (data.selectedKey is string && data.selectedKey.size() <= 128)) &&
        (!('isSidebarCollapsed' in data) || data.isSidebarCollapsed is bool);
    }

    // Validation stricte d'une alerte de prix seuil
    function isValidAlert(data, userId, alertId) {
      return data.keys().hasAll([
          'id', 'userId', 'portfolioKey', 'portfolioName', 'shortName',
          'targetPrice', 'direction', 'active', 'triggered', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'portfolioKey', 'portfolioName', 'shortName',
          'externalIsin', 'externalMic', 'yahooTicker',
          'targetPrice', 'direction', 'active', 'triggered',
          'triggeredAt', 'triggeredPrice', 'note', 'createdAt', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id == alertId &&
        isValidId(data.id) &&
        data.portfolioKey is string && data.portfolioKey.size() >= 1 && data.portfolioKey.size() <= 128 &&
        data.portfolioName is string && data.portfolioName.size() >= 1 && data.portfolioName.size() <= 200 &&
        data.shortName is string && data.shortName.size() >= 1 && data.shortName.size() <= 30 &&
        (!('externalIsin' in data) || (data.externalIsin is string && data.externalIsin.size() <= 30)) &&
        (!('externalMic' in data) || (data.externalMic is string && data.externalMic.size() <= 20)) &&
        (!('yahooTicker' in data) || (data.yahooTicker is string && data.yahooTicker.size() <= 30)) &&
        data.targetPrice is number && data.targetPrice > 0 &&
        data.direction in ['above', 'below'] &&
        data.active is bool &&
        data.triggered is bool &&
        (!('triggeredAt' in data) || data.triggeredAt == null || (data.triggeredAt is string && data.triggeredAt.size() <= 64)) &&
        (!('triggeredPrice' in data) || data.triggeredPrice == null || (data.triggeredPrice is number && data.triggeredPrice >= 0)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Collection des profils utilisateurs
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Sous-collection des portefeuilles de l'utilisateur
      match /portfolios/{portfolioId} {
        allow get: if isOwner(userId) && isValidId(portfolioId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(portfolioId) &&
          isValidPortfolio(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidId(portfolioId) &&
          isValidPortfolio(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(portfolioId);
      }

      // Sous-collection des réglages et préférences
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(settingId) &&
          isValidSettings(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidId(settingId) &&
          isValidSettings(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      // Sous-collection des alertes de prix seuil
      match /alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(alertId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) &&
          isValidId(alertId) &&
          isValidAlert(incoming(), userId, alertId);
        allow update: if isOwner(userId) &&
          isValidId(alertId) &&
          isValidAlert(incoming(), userId, alertId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'targetPrice', 'direction', 'active', 'triggered',
            'triggeredAt', 'triggeredPrice', 'note', 'updatedAt',
            'portfolioName', 'shortName', 'externalIsin', 'externalMic', 'yahooTicker'
          ]);
        allow delete: if isOwner(userId) && isValidId(alertId);
      }
    }
  }
}
